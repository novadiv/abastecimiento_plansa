# ═══════════════════════════════════════════════════════════════════════
#  ABASTECIMIENTO — Plantilla de configuración
#  ---------------------------------------------------------------------
#  Copiar este archivo como ".env" en la raíz del proyecto y rellenar los
#  valores reales. El ".env" NO se versiona (contiene la contraseña).
#
#      Windows PowerShell:   Copy-Item .env.example .env
#      Linux / macOS:        cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════

# ── BASE DE DATOS — SQL Server (acceso SOLO LECTURA) ──────────────────
DB_HOST=192.168.1.250
DB_PORT=1433
DB_NAME=PlaproduccionBD
DB_USER=usuario_solo_lectura
DB_PASSWORD=
DB_DRIVER=ODBC Driver 11 for SQL Server
DB_LINKED_SERVER=FOX
DB_QUERY_TIMEOUT=300
DB_CONNECT_TIMEOUT=15
DB_SOLO_LECTURA=true

# ── BACKEND (FastAPI) ─────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8100
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CACHE_TTL_SEGUNDOS=900

# ── DOMINIO ───────────────────────────────────────────────────────────
EMPRESA_ID=001
COBERTURA_MESES_DEFECTO=2
DIAS_EN_CAMINO=90

# ── FRONTEND (Vite) ───────────────────────────────────────────────────
VITE_API_BASE_URL=http://servidor-interno:8000/api
VITE_ABASTECIMIENTO_API_URL=http://127.0.0.1:8100/api

# ── Bot RPA ─────────────────────────────────────────────────────────
# Secreto compartido entre el backend y el proceso del bot. El bot lo manda
# en la cabecera X-Bot-Token; sin él no puede declarar trabajo como hecho.
BOT_TOKEN=genera-uno-con-secrets.token_urlsafe(32)
BOT_DB_RUTA=datos/bot.sqlite3
BOT_CAPTURAS_DIR=BotRpaNetcomercial/screenshots
BOT_LATIDO_MINUTOS=15
BOT_MAX_ITEMS_CORRIDA=40
