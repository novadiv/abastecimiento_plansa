# ════════════════════════════════════════════════════════════════════
#  Configuracion propia del bot.
#
#  Copia este archivo a `.env` y completa los valores. El `.env` real
#  NUNCA se sube a git.
#
#  Lo que el bot comparte con el backend (BOT_TOKEN, API_BASE_URL) se lee
#  del `.env` de la RAIZ del proyecto, no de aqui. Hay un solo token, en un
#  solo sitio: asi no puede quedar desincronizado.
# ════════════════════════════════════════════════════════════════════

# ── Credenciales de la sesion remota y de la aplicacion ─────────────
APP_USUARIO=
APP_PASSWORD=

# ── Comportamiento de las corridas (todos son opcionales) ───────────
# Segundos de aviso a pantalla completa antes de tomar el control.
BOT_AVISO_SEGUNDOS=60
# Cuanto se corre la corrida si eliges "Posponer".
BOT_MINUTOS_POSPONER=15
# Cada cuanto el runner relee los horarios de la API.
BOT_RECARGA_HORARIOS_MINUTOS=5
# Cuantas veces se reintenta una unidad antes de darla por fallida.
BOT_MAX_REINTENTOS=2
# Que tarea atiende este worker.
BOT_TAREA=oc_netcomercial

# ── Solo si este bot corre en OTRA maquina que el backend ───────────
# Por defecto los toma del .env de la raiz. Descomenta solo si hace falta.
# API_BASE_URL=http://192.168.1.50:8100
# BOT_TOKEN=el-mismo-valor-que-el-del-backend
